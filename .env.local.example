NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — only needed if you want live Google star ratings on public
# profiles. Without it, the Google Reviews link still works, it just won't
# show the live rating/review count badge. Never prefix this with
# NEXT_PUBLIC_ — it must stay server-only.
GOOGLE_PLACES_API_KEY=
